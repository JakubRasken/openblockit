<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/statsFrame"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/sharableContent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/whiteCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="@dimen/glass_margin_bottom"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurfaceBright"
                    app:cardCornerRadius="@dimen/large_corner"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:id="@+id/bestContainer"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:layout_gravity="top|center_horizontal"
                                android:id="@+id/statsPeriod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:letterSpacing="0.2"/>
                            <it.mirko.widget.display.TileDisplay
                                android:id="@+id/statsDisplay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="24dp"
                                android:layout_marginBottom="24dp"
                                android:layout_marginStart="24dp"
                                android:layout_marginEnd="24dp"/>
                            <FrameLayout
                                android:layout_gravity="bottom"
                                android:id="@+id/statsDayLabels"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:layout_marginStart="24dp"
                                android:layout_marginEnd="24dp"/>
                        </FrameLayout>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.75">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/bestCard"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="16dp"
                                app:cardBackgroundColor="@color/colorSurfaceBright"
                                app:strokeColor="@color/colorSurface"
                                style="@style/Widget.Material3.CardView.Outlined">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:translationY="80dp"
                                    android:rotation="45"
                                    app:cardBackgroundColor="#0000"
                                    app:cardCornerRadius="@dimen/large_corner"
                                    app:strokeColor="@color/colorSurface"
                                    app:strokeWidth="8dp"
                                    style="@style/Widget.Material3.CardView.Outlined"/>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_gravity="end|top"
                                    android:layout_width="80dp"
                                    android:layout_height="40dp"
                                    android:layout_margin="16dp"
                                    android:translationX="80dp"
                                    android:translationY="80dp"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:cardCornerRadius="40dp"
                                    app:strokeColor="@color/colorSurface"
                                    app:strokeWidth="4dp"
                                    style="@style/Widget.Material3.CardView.Outlined"/>
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:layout_margin="16dp"
                                    android:translationX="-50dp"
                                    android:rotation="56"
                                    app:cardBackgroundColor="@color/colorPrimaryContainer"
                                    app:cardCornerRadius="50dp"
                                    app:strokeColor="@color/colorPrimaryContainer"
                                    app:strokeWidth="2dp"
                                    style="@style/Widget.Material3.CardView.Outlined"/>
                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:orientation="vertical"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <TextView
                                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                        android:textStyle="bold"
                                        android:gravity="center_horizontal"
                                        android:id="@+id/bestType"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="16dp"
                                        android:text="@string/best_result_day"
                                        android:alpha="0.8"
                                        android:textAllCaps="true"/>
                                    <Space
                                        android:layout_width="0dp"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"/>
                                    <androidx.appcompat.widget.LinearLayoutCompat
                                        android:orientation="vertical"
                                        android:clipChildren="false"
                                        android:clipToPadding="false"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="16dp">
                                        <TextView
                                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                            android:textStyle="bold"
                                            android:gravity="center_horizontal"
                                            android:id="@+id/bestLabel"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="31 gen"
                                            android:textAllCaps="false"/>
                                        <TextView
                                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                            android:textStyle="bold"
                                            android:gravity="center_horizontal"
                                            android:id="@+id/bestValue"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="267 minuti"/>
                                    </androidx.appcompat.widget.LinearLayoutCompat>
                                </androidx.appcompat.widget.LinearLayoutCompat>
                            </com.google.android.material.card.MaterialCardView>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:paddingTop="16dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:orientation="vertical"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">
                                <TextView
                                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                    android:textStyle="bold"
                                    android:gravity="center_horizontal"
                                    android:id="@+id/currentDisplayDate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="Oggi"
                                    android:alpha="0.8"
                                    android:textAllCaps="true"/>
                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorOnSurface"
                                    android:gravity="center_horizontal"
                                    android:id="@+id/totalMinutesInStats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"/>
                                <TextView
                                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                                    android:textColor="@color/colorOnSurface"
                                    android:gravity="center_horizontal"
                                    android:id="@+id/statsDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/with_no_distraction"/>
                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"/>
                                <FrameLayout
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <it.mirko.views.BlockLogoStatic
                                        android:layout_gravity="bottom|center_horizontal"
                                        android:id="@+id/shareLogo"
                                        android:visibility="invisible"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="26dp"
                                        android:alpha="0.3"/>
                                    <it.mirko.widget.HapticButton
                                        android:textStyle="bold"
                                        android:layout_gravity="center_horizontal"
                                        android:id="@+id/shareButton"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="16dp"
                                        android:text="@string/complete_session_share_action"
                                        app:icon="@drawable/ic_share"
                                        app:iconGravity="textStart"
                                        app:iconPadding="16dp"
                                        style="@style/Widget.Material3.Button.TonalButton"/>
                                </FrameLayout>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.75">
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/emptyState"
                                    android:layout_width="88dp"
                                    android:layout_height="88dp"
                                    android:alpha="0"
                                    app:cardBackgroundColor="#0000"
                                    app:cardCornerRadius="@dimen/small_corner"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:layout_width="64dp"
                                        android:layout_height="64dp"
                                        android:src="@drawable/ic_no_session"
                                        app:tint="@color/colorOnSurface"/>
                                </com.google.android.material.card.MaterialCardView>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <it.mirko.widget.HapticCard
                        android:layout_gravity="end|top"
                        android:id="@+id/statsShareTile"
                        android:visibility="gone"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:cardCornerRadius="@dimen/small_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/colorOnSurfaceVariant"/>
                    </it.mirko.widget.HapticCard>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <it.mirko.widget.stats.StatisticsGraph
                    android:id="@+id/statisticsGraph"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:gravity="center"
                    android:layout_gravity="top|center_horizontal"
                    android:id="@+id/statsPeriodOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.18"/>
            </FrameLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statsPeriodBox"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="@dimen/large_corner"
                style="@style/Widget.Material3.CardView.Outlined">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <it.mirko.widget.HapticCard
                        android:id="@+id/statsPrev"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_prev"
                            app:tint="@color/colorOnSurfaceVariant"/>
                    </it.mirko.widget.HapticCard>
                    <View
                        android:background="@color/colorOutline"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:alpha="0.5"/>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/statsPeriodValue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"/>
                    <View
                        android:background="@color/colorOutline"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:alpha="0.5"/>
                    <it.mirko.widget.HapticCard
                        android:id="@+id/statsNext"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_prev"
                            android:rotation="180"
                            app:tint="@color/colorOnSurfaceVariant"/>
                    </it.mirko.widget.HapticCard>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
            <it.mirko.widget.SquareContainer
                android:orientation="horizontal"
                android:id="@+id/statsSquare"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:squareRatio="0.86">
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="96dp"
                            android:layout_height="match_parent">
                            <it.mirko.widget.HapticBuyTile
                                android:id="@+id/statsModeDay"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Left"
                                style="@style/Widget.Material3.CardView.Filled"/>
                            <Space
                                android:layout_width="0dp"
                                android:layout_height="6dp"/>
                            <it.mirko.widget.HapticBuyTile
                                android:id="@+id/statsModeMonth"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Center.Left"
                                style="@style/Widget.Material3.CardView.Filled"/>
                            <Space
                                android:layout_width="0dp"
                                android:layout_height="6dp"/>
                            <it.mirko.widget.HapticBuyTile
                                android:id="@+id/statsModeYear"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Left"
                                style="@style/Widget.Material3.CardView.Filled"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <Space
                            android:layout_width="6dp"
                            android:layout_height="0dp"/>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/statsRotaryPanel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/colorSurfaceVariant"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Right"
                            style="@style/Widget.Material3.CardView.Filled">
                            <it.mirko.widget.RotaryWheel
                                android:id="@+id/statsRotary"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
            </it.mirko.widget.SquareContainer>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</merge>
