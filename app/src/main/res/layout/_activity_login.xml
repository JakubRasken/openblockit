<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="56dp"
        android:layout_weight="4">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp">
            <TextView
                android:textStyle="bold"
                android:gravity="bottom"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/welcome_hello"
                android:layout_weight="2"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="12sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="100sp"
                style="@style/TextAppearance.Material3.DisplaySmall"/>
            <TextView
                android:id="@+id/desc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="@string/welcome_title"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="20sp"
                style="@style/TextAppearance.Material3.TitleLarge"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.5"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/ticketContainer"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:rotation="0"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp">
            <com.vipulasri.ticketview.TicketView
                android:layout_gravity="center"
                android:id="@+id/ticketView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ticketBackgroundColor="?attr/colorSurfaceBright"
                app:ticketBorderColor="?attr/colorOutline"
                app:ticketBorderWidth="3dp"
                app:ticketCornerRadius="12dp"
                app:ticketCornerType="rounded"
                app:ticketDividerColor="?attr/colorOutline"
                app:ticketDividerDashGap="3dp"
                app:ticketDividerDashLength="6dp"
                app:ticketDividerPadding="4dp"
                app:ticketDividerType="dash"
                app:ticketDividerWidth="1dp"
                app:ticketElevation="0dp"
                app:ticketOrientation="vertical"
                app:ticketScallopPositionPercent="70"
                app:ticketScallopRadius="12dp"
                app:ticketShowBorder="true"
                app:ticketShowDivider="true"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"/>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3">
                    <it.mirko.views.BlockLogoStatic
                        android:layout_gravity="center"
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:alpha="0.1"
                        android:rotation="-90"/>
                </FrameLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:layout_weight="70">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/welcome_passenger"
                            android:layout_marginEnd="8dp"/>
                        <FrameLayout
                            android:layout_gravity="end"
                            android:id="@+id/dotUser"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:scaleX="0"
                            android:scaleY="0">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/dot"
                                android:tint="?attr/colorSurfaceBright"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:src="@drawable/dot"/>
                        </FrameLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <FrameLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.robinhood.ticker.TickerView
                            android:id="@+id/tickerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            app:ticker_animateMeasurementChange="true"/>
                    </FrameLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/iconNotification"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_notification"/>
                            <FrameLayout
                                android:layout_gravity="end"
                                android:id="@+id/dotNotification"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:scaleX="0"
                                android:scaleY="0">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/dot"
                                    android:tint="?attr/colorSurfaceBright"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:src="@drawable/dot"/>
                            </FrameLayout>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/iconAdmin"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_admin"/>
                            <FrameLayout
                                android:layout_gravity="end"
                                android:id="@+id/dotAdmin"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:scaleX="0"
                                android:scaleY="0">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/dot"
                                    android:tint="?attr/colorSurfaceBright"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:src="@drawable/dot"/>
                            </FrameLayout>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/iconOverlay"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_overlay"/>
                            <FrameLayout
                                android:layout_gravity="end"
                                android:id="@+id/dotOverlay"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:scaleX="0"
                                android:scaleY="0">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/dot"
                                    android:tint="?attr/colorSurfaceBright"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:src="@drawable/dot"/>
                            </FrameLayout>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/iconAlarm"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_alarm"/>
                            <FrameLayout
                                android:layout_gravity="end"
                                android:id="@+id/dotAlarm"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:scaleX="0"
                                android:scaleY="0">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/dot"
                                    android:tint="?attr/colorSurfaceBright"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:src="@drawable/dot"/>
                            </FrameLayout>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/iconTelephony"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_call"/>
                            <FrameLayout
                                android:layout_gravity="end"
                                android:id="@+id/dotTelephony"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:scaleX="0"
                                android:scaleY="0">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/dot"
                                    android:tint="?attr/colorSurfaceBright"/>
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:src="@drawable/dot"/>
                            </FrameLayout>
                        </FrameLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="30"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/parachuteContainer"
            android:layout_width="160dp"
            android:layout_height="190dp"
            android:alpha="0"
            android:translationX="290dp"
            android:rotation="-90">
            <com.vipulasri.ticketview.TicketView
                android:layout_gravity="center"
                android:id="@+id/ticketParachute"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ticketBackgroundColor="?attr/colorPrimaryContainer"
                app:ticketBorderColor="@color/colorOnPrimaryContainer"
                app:ticketBorderWidth="3dp"
                app:ticketCornerRadius="12dp"
                app:ticketCornerType="rounded"
                app:ticketDividerColor="@color/colorOnPrimaryContainer"
                app:ticketDividerDashGap="3dp"
                app:ticketDividerDashLength="6dp"
                app:ticketDividerPadding="4dp"
                app:ticketDividerType="dash"
                app:ticketDividerWidth="1dp"
                app:ticketElevation="0dp"
                app:ticketOrientation="horizontal"
                app:ticketScallopPositionPercent="70"
                app:ticketScallopRadius="12dp"
                app:ticketShowBorder="true"
                app:ticketShowDivider="true"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="7"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3">
                    <it.mirko.views.BlockLogoStaticWhite
                        android:layout_gravity="center"
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"/>
                </FrameLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="24dp"
                    android:layout_weight="70">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_parachute"
                            android:layout_weight="1"
                            android:rotation="-25"
                            app:tint="@color/colorOnPrimaryContainer"/>
                        <com.robinhood.ticker.TickerView
                            android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnPrimaryContainer"
                            android:gravity="center"
                            android:id="@+id/parachuteCount"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="99"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="30"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
    </FrameLayout>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pulseDot"
            android:visibility="visible"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/dot"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:gravity="start"
            android:layout_gravity="center"
            android:id="@+id/missingPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parachute_count_text"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <it.mirko.widget.HapticButton
                android:textStyle="bold"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/permissionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_signin_button_text_long"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button"/>
            <it.mirko.widget.HapticButton
                android:textStyle="bold"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/notNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_not_now"
                app:iconGravity="textStart"
                style="@style/Widget.Material3.Button.TextButton"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="100"
            android:alpha="0.3"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:trackColor="@color/colorOnSurfaceVariant"
            app:trackCornerRadius="0.5dp"
            app:trackThickness="1dp"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/you_accept"
            android:alpha="0.6"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:breakStrategy="balanced"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:layout_gravity="end"
                    android:id="@+id/privacyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_policy"
                    style="@style/Widget.Material3.Button.TextButton"/>
            </FrameLayout>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="•"
                android:alpha="0.8"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.google.android.material.button.MaterialButton
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:layout_gravity="start"
                    android:id="@+id/termsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_and_conditions"
                    style="@style/Widget.Material3.Button.TextButton"/>
            </FrameLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
