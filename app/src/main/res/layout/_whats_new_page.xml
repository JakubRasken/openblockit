<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <FrameLayout
        android:id="@+id/wnPageAnim"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnSurfaceVariant"
        android:id="@+id/wnPageKicker"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAllCaps="true"
        android:fontFamily="monospace"
        android:letterSpacing="0.18"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimaryContainer"
        android:id="@+id/wnPageBadge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/wn_premium_badge"
        android:fontFamily="monospace"
        android:letterSpacing="0.18"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/wnPageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/wnPageBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:alpha="0.7"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/colorPrimaryContainer"
        android:id="@+id/wnPagePremiumCta"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/wn_premium_cta"
        android:textAllCaps="false"
        app:cornerRadius="18dp"
        app:strokeColor="@color/colorPrimaryContainer"
        style="@style/Widget.Material3.Button.OutlinedButton"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="110dp"
        android:layout_weight="1"/>
</androidx.appcompat.widget.LinearLayoutCompat>
