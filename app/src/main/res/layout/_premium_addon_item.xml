<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/addonCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/large_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">
                <it.mirko.widget.BagTiles
                    android:id="@+id/addonTiles"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <it.mirko.views.SoundBars
                    android:id="@+id/addonBars"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/colorPrimaryContainer"
                android:id="@+id/addonEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/bag_six_eyebrow"
                android:fontFamily="@font/google_sans_bold"
                android:letterSpacing="0.22"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="21sp"
                    android:textColor="@color/colorOnSurface"
                    android:id="@+id/addonTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/bag_six_title"
                    android:layout_weight="1"
                    android:fontFamily="@font/google_sans_bold"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/addonLock"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="10dp"
                    app:tint="@color/colorPrimaryContainer"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:id="@+id/addonDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bag_six_body_short"
                android:fontFamily="@font/google_sans_regular"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <View
                    android:background="@color/colorPrimaryContainer"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurface"
                    android:id="@+id/addonPointOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_addon_lifetime"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <View
                    android:background="@color/colorPrimaryContainer"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurface"
                    android:id="@+id/addonPointTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_addon_keeps"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <it.mirko.widget.SlideToStart
                android:id="@+id/addonSlide"
                android:background="@drawable/slide_track_on_card"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="14dp"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/addonOwned"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/large_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_check"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/colorOnPrimaryContainer"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/colorOnPrimaryContainer"
                        android:id="@+id/addonOwnedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_addon_owned"
                        android:fontFamily="@font/google_sans_bold"
                        android:letterSpacing="0.03"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:gravity="center"
                android:id="@+id/addonPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/premium_one_time"
                android:fontFamily="@font/google_sans_regular"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
</androidx.appcompat.widget.LinearLayoutCompat>
