<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppWidget.AppWidgetContainer.GigaIcon"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.AppWidget.Container">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2">
            <ImageView
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_widget_tiles_preview_stacked"
                android:scaleType="fitCenter"
                android:tint="@color/color_on_surface"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <FrameLayout
                android:background="@drawable/app_widget_box_filled"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="00:45"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/app_widget_box_faded"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/widget_on_surface_variant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/app_widget_box_play"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_play"
                    android:tint="?attr/colorOnPrimary"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
