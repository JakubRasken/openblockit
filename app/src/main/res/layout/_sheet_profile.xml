<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/profileSheetRoot"
    android:background="@drawable/sheet_bg"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_gravity="center_horizontal"
        android:id="@+id/profileHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorPrimaryContainer"
        android:id="@+id/profileEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/onb_passenger"
        android:fontFamily="@font/google_sans_bold"
        android:layout_marginStart="6dp"
        android:letterSpacing="0.22"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/profileSheetPhoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_account"
            android:importantForAccessibility="no"
            app:tint="@color/colorOnSurface"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="28sp"
                android:textColor="@color/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/profileSheetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_bold"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:ellipsize="end"
                android:id="@+id/profileSheetEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <Space
        android:layout_width="0dp"
        android:layout_height="24dp"/>
    <it.mirko.widget.HapticCard
        android:id="@+id/rowSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/small_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_navigation_settings"
                android:importantForAccessibility="no"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/menu_settings_theme"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </it.mirko.widget.HapticCard>
    <Space
        android:layout_width="0dp"
        android:layout_height="6dp"/>
    <it.mirko.widget.HapticCard
        android:id="@+id/rowShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/small_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_share"
                android:importantForAccessibility="no"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/menu_share_app"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </it.mirko.widget.HapticCard>
    <Space
        android:layout_width="0dp"
        android:layout_height="6dp"/>
    <it.mirko.widget.HapticCard
        android:id="@+id/rowReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/small_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star"
                android:importantForAccessibility="no"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/menu_review"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </it.mirko.widget.HapticCard>
    <Space
        android:layout_width="0dp"
        android:layout_height="6dp"/>
    <it.mirko.widget.HapticCard
        android:id="@+id/rowRemoveAds"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/small_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_premium"
                android:importantForAccessibility="no"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/premium_tab_premium"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </it.mirko.widget.HapticCard>
    <Space
        android:layout_width="0dp"
        android:layout_height="6dp"/>
    <it.mirko.widget.HapticCard
        android:id="@+id/rowAddon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/small_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_addon"
                android:importantForAccessibility="no"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/premium_tab_addon"
                android:layout_weight="1"
                android:layout_marginStart="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </it.mirko.widget.HapticCard>
    <Space
        android:layout_width="0dp"
        android:layout_height="24dp"/>
    <FrameLayout
        android:id="@+id/accountButtonsSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp">
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="@color/colorSurface"
            android:id="@+id/profileSignIn"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onb_sign_in_google"
            android:textAllCaps="false"
            app:backgroundTint="@color/colorOnSurface"
            app:cornerRadius="18dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/accountActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/colorOnSurface"
                android:id="@+id/profileSignOut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_exit"
                android:layout_weight="1"
                android:textAllCaps="false"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_exit"
                app:iconTint="@color/colorOnSurface"
                app:strokeColor="@color/colorOnSurface"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="?attr/colorError"
                android:id="@+id/profileDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/account_delete_action"
                android:layout_weight="1"
                android:textAllCaps="false"
                app:cornerRadius="18dp"
                app:strokeColor="?attr/colorError"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:id="@+id/profilePrivacy"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_policy"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:id="@+id/profileTerms"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terms_and_conditions"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>
