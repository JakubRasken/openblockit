<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppWidget.AppWidgetContainer.GigaIcon"
    android:id="@+id/streakRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.AppWidget.Container">
    <ImageView
        android:id="@+id/streakQuiet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:tint="@color/widget_tile_quiet"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/streakInk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:tint="?attr/colorOnSurface"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/streakAccent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:tint="?attr/colorPrimary"
        android:importantForAccessibility="no"/>
</FrameLayout>
