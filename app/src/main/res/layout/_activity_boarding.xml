<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/boardingRoot"
    android:background="@color/colorSurface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/boardingContent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <FrameLayout
            android:id="@+id/boardingTopBand"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <it.mirko.views.BlockLogoStatic
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/boardingLogo"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="21dp"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="start|top"
                android:id="@+id/boardingStreakPill"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:elevation="0dp"
                app:cardBackgroundColor="@color/colorSurfaceBright"
                app:cardCornerRadius="40dp"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <View
                        android:id="@+id/boardingStreakTile"
                        android:background="@drawable/square_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"/>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/boardingStreakCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="end|top"
                android:id="@+id/boardingPill"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:elevation="0dp"
                app:cardBackgroundColor="@color/colorSurfaceBright"
                app:cardCornerRadius="20dp"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:elevation="0dp"
                        app:cardBackgroundColor="?attr/colorOnSurface"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_parachute"
                            android:rotation="-25"
                            app:tint="?attr/colorSurface"/>
                    </com.google.android.material.card.MaterialCardView>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/boardingPillCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <View
                        android:background="@color/colorOnSurfaceVariant"
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:alpha="0.35"/>
                    <Space
                        android:layout_width="3dp"
                        android:layout_height="0dp"/>
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_gravity="center"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:elevation="0dp"
                            app:cardBackgroundColor="@color/colorSurface"
                            app:cardCornerRadius="20dp"
                            style="@style/Widget.Material3.CardView.Filled">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_account"
                                app:tint="?attr/colorOnSurface"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:id="@+id/boardingPillPhoto"
                                android:layout_width="40dp"
                                android:layout_height="40dp"/>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/boardingGlass"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:transitionName="session_glass"
            app:cardBackgroundColor="@color/colorSurfaceBright"
            app:cardCornerRadius="@dimen/large_corner"
            app:cardElevation="0dp"
            style="@style/Widget.Material3.CardView.Filled">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/boardingGlassBody"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/boardingCounterHost"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <it.mirko.widget.display.TileDisplay
                        android:id="@+id/boardingCounter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/boardingDigits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <it.mirko.widget.numbers.SquareNumber
                            android:id="@+id/boardingDigitTens"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <Space
                            android:id="@+id/boardingDigitGap"
                            android:layout_width="8dp"
                            android:layout_height="1dp"/>
                        <it.mirko.widget.numbers.SquareNumber
                            android:id="@+id/boardingDigitOnes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </FrameLayout>
                <it.mirko.widget.display.TileDisplay
                    android:id="@+id/boardingProgress"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="0.22"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/boardingMiddle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/glass_content_gap">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/boardingStack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/boardingTitleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/boardingTitleRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="12dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/boardingIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            app:tint="@color/colorOnSurface"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/colorOnSurface"
                            android:id="@+id/boardingName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:fontFamily="@font/google_sans_bold"
                            android:layout_marginStart="12dp"
                            android:letterSpacing="0.1"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/boardingBodyCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:cardElevation="0dp"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:gravity="top"
                            android:id="@+id/boardingDesc"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.12"
                            android:fontFamily="@font/google_sans_regular"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:id="@+id/boardingNoteRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp">
                            <View
                                android:id="@+id/boardingNoteDot"
                                android:background="@color/colorPrimaryContainer"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="6dp"/>
                            <TextView
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:ellipsize="end"
                                android:id="@+id/boardingNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="3"
                                android:lineSpacingMultiplier="1.08"
                                android:alpha="0.72"
                                android:fontFamily="@font/google_sans_regular"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <Space
                android:id="@+id/boardingWheelGap"
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <it.mirko.widget.AdvanceLever
                android:id="@+id/boardingStepper"
                android:layout_width="96dp"
                android:layout_height="match_parent"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/boardingGrant"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/rail_gap"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/large_corner"
            app:cardElevation="0dp"
            style="@style/Widget.Material3.CardView.Filled">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:gravity="center"
                android:id="@+id/boardingGrantText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textAllCaps="true"
                android:fontFamily="@font/google_sans_bold"
                android:letterSpacing="0.12"/>
        </com.google.android.material.card.MaterialCardView>
        <FrameLayout
            android:id="@+id/boardingSlideCard"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="-72dp">
            <it.mirko.widget.SlideToStart
                android:id="@+id/boardingSlide"
                android:background="@drawable/slide_track"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/boardingFooter"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:id="@+id/boardingPrivacy"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_regular"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:fontFamily="@font/google_sans_regular"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorOnSurface"
                android:id="@+id/boardingGuest"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boarding_guest_enter"
                android:fontFamily="@font/google_sans_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:id="@+id/boardingTerms"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_regular"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <it.mirko.views.BlockLogoSplash
        android:layout_gravity="center"
        android:id="@+id/boardingIntroMark"
        android:visibility="invisible"
        android:layout_width="120dp"
        android:layout_height="120dp"/>
</FrameLayout>
