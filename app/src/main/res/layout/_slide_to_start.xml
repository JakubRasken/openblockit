<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textColor="@color/colorOnSurfaceVariant"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/slideHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/slide_to_start"
        android:maxLines="1"
        android:textAllCaps="true"
        android:fontFamily="@font/google_sans_bold"
        android:layout_marginStart="92dp"
        android:layout_marginEnd="20dp"
        android:letterSpacing="0.1"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"/>
    <View
        android:layout_gravity="end|center_vertical"
        android:id="@+id/slideGoal"
        android:background="@color/colorOnSurface"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:alpha="0.35"
        android:layout_marginEnd="26dp"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/slideHandle"
        android:layout_width="76dp"
        android:layout_height="56dp"
        android:transitionName="session_handle"
        app:cardBackgroundColor="@color/colorOnSurface"
        app:cardCornerRadius="@dimen/small_corner"
        app:cardElevation="0dp"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/slideHandleIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_play"
            android:importantForAccessibility="no"
            app:tint="@color/colorSurface"/>
    </com.google.android.material.card.MaterialCardView>
</merge>
