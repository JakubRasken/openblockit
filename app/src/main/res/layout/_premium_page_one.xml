<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/premiumPageOne"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/premiumCardSessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/large_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="19sp"
                        android:textColor="@color/colorOnSurface"
                        android:id="@+id/premiumSessionsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_feat_sessions_title"
                        android:layout_weight="1"
                        android:fontFamily="@font/google_sans_bold"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/premiumLockSessions"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="8dp"
                        app:tint="@color/colorPrimaryContainer"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:id="@+id/premiumSessionsDesc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/premium_feat_sessions_desc"
                    android:layout_weight="1"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/premiumDemoSessions"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <it.mirko.widget.HoursDemoView
                    android:id="@+id/premiumHours"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="10dp"/>
            </com.google.android.material.card.MaterialCardView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/premiumCardRoutine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/large_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="19sp"
                        android:textColor="@color/colorOnSurface"
                        android:id="@+id/premiumRoutineTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_feat_routine_title"
                        android:layout_weight="1"
                        android:fontFamily="@font/google_sans_bold"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/premiumLockRoutine"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="8dp"
                        app:tint="@color/colorPrimaryContainer"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:id="@+id/premiumRoutineDesc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/premium_feat_routine_desc"
                    android:layout_weight="1"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/premiumDemoRoutine"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <it.mirko.widget.TimelineBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/premiumClock"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>
            </com.google.android.material.card.MaterialCardView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/premiumCardBags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/large_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="19sp"
                        android:textColor="@color/colorOnSurface"
                        android:id="@+id/premiumBagsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/premium_feat_bags_title"
                        android:layout_weight="1"
                        android:fontFamily="@font/google_sans_bold"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/premiumLockBags"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        android:importantForAccessibility="no"
                        android:layout_marginStart="8dp"
                        app:tint="@color/colorPrimaryContainer"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:id="@+id/premiumBagsDesc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/premium_feat_bags_desc"
                    android:layout_weight="1"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/premiumDemoBags"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/premiumBagsRow"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <it.mirko.widget.display.TileDisplay
                        android:id="@+id/premiumBagsPlus"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <it.mirko.widget.BagTiles
                        android:id="@+id/premiumBags"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1.5"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <it.mirko.widget.SlideToStart
        android:id="@+id/premiumSlide"
        android:background="@drawable/slide_track"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/premiumOwned"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/colorPrimaryContainer"
        app:cardCornerRadius="@dimen/large_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/premiumOwnedIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check"
                android:importantForAccessibility="no"
                android:layout_marginEnd="10dp"
                app:tint="@color/colorOnPrimaryContainer"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/colorOnPrimaryContainer"
                android:id="@+id/premiumOwnedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_already"
                android:fontFamily="@font/google_sans_bold"
                android:letterSpacing="0.03"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/colorOnSurfaceVariant"
        android:gravity="center"
        android:id="@+id/premiumPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:text="@string/premium_one_time"
        android:fontFamily="@font/google_sans_regular"/>
</androidx.appcompat.widget.LinearLayoutCompat>
