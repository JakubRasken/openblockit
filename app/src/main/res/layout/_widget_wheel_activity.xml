<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wheelScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="bottom"
        android:id="@+id/wheelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/widget_margin"
        app:cardBackgroundColor="@color/widget_bg_container"
        app:cardCornerRadius="@dimen/large_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="88dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="24dp"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorPrimary"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/deletePreset"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_delete_preset"
                    android:contentDescription="@android:string/cancel"
                    android:layout_marginEnd="24dp"
                    app:tint="@color/widget_on_bg_container"/>
                <it.mirko.widget.HapticFAB
                    android:layout_gravity="center"
                    android:id="@+id/startFromWheel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_done"
                    android:contentDescription="@string/widget_preset_title"
                    android:layout_marginEnd="16dp"
                    android:translationZ="0dp"
                    android:backgroundTint="?attr/colorPrimary"
                    app:pressedTranslationZ="0dp"
                    app:rippleColor="@color/color_on_primary_alpha"
                    app:tint="?attr/colorOnPrimary"/>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wheelInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/widget_primary_container"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="start"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/wheelDigits"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="32dp"
                        android:layout_weight="1">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <it.mirko.widget.numbers.SquareNumber
                                android:id="@+id/wheelHourLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <Space
                                android:layout_width="24dp"
                                android:layout_height="0dp"/>
                            <it.mirko.widget.numbers.SquareNumber
                                android:id="@+id/wheelHourRight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="24dp"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.7">
                            <it.mirko.widget.numbers.SquareNumber
                                android:id="@+id/wheelMinuteLeft"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <Space
                                android:layout_width="24dp"
                                android:layout_height="0dp"/>
                            <it.mirko.widget.numbers.SquareNumber
                                android:id="@+id/wheelMinuteRight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </LinearLayout>
                    <it.mirko.widget.HapticSliderMaterial
                        android:id="@+id/wheelSlider"
                        android:layout_width="96dp"
                        android:layout_height="284dp"
                        android:layout_margin="16dp"
                        app:cardBackgroundColor="@color/widget_primary_container"
                        app:cardCornerRadius="@dimen/small_corner"
                        app:strokeColor="@color/widget_bg_container"
                        style="@style/Widget.Material3.CardView.Outlined"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
