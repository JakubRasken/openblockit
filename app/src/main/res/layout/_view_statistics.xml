<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceSlider.Up"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.robinhood.spark.SparkView
                    android:id="@+id/daySparkView"
                    android:paddingTop="48dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>
                <com.robinhood.spark.SparkView
                    android:id="@+id/monthSparkView"
                    android:paddingTop="48dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>
                <com.robinhood.spark.SparkView
                    android:id="@+id/yearSparkView"
                    android:paddingTop="48dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fakeScrub"
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="46dp"
                    android:layout_marginBottom="2dp"
                    android:alpha="0"
                    app:cardBackgroundColor="@color/colorPrimaryContainer"
                    style="@style/Widget.Material3.CardView.Filled"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/graphHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.9"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceSlider.Up"
                    style="@style/Widget.Material3.CardView.Filled">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="48dp"
                        android:text="@string/stats_hint"
                        android:textAllCaps="true"
                        android:breakStrategy="balanced"/>
                </com.google.android.material.card.MaterialCardView>
                <it.mirko.widget.HapticButton
                    android:layout_gravity="end"
                    android:id="@+id/resetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="0dp"
                    app:icon="@drawable/ic_calendar_today"
                    app:iconTint="@color/colorOnSurface"
                    style="@style/Widget.Material3.Button.IconButton"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scrubContainer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="8dp"
                    android:scaleX="0.5"
                    android:scaleY="0.5"
                    app:cardBackgroundColor="@color/colorPrimaryContainer"
                    app:cardCornerRadius="16dp"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/colorOnPrimaryContainer"
                            android:id="@+id/scrubTextTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="22 gen 2030"
                            android:layout_weight="1"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnPrimaryContainer"
                            android:id="@+id/scrubTextDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 ora 27 minuti"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <it.mirko.widget.HapticButton
                    android:id="@+id/prevButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:icon="@drawable/ic_prev"
                    app:iconTint="@color/colorOnSurface"
                    style="@style/Widget.Material3.Button.IconButton"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/currentDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Oggi"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <it.mirko.widget.HapticButton
                    android:id="@+id/nextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:rotation="180"
                    app:icon="@drawable/ic_prev"
                    app:iconTint="@color/colorOnSurface"
                    style="@style/Widget.Material3.Button.IconButton"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <Space
        android:layout_width="0dp"
        android:layout_height="4dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="96dp">
        <it.mirko.widget.HapticCard
            android:id="@+id/stats_filter_day"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Left"
            app:strokeColor="@color/colorOnSurfaceVariant"
            style="@style/Widget.Material3.CardView.Filled">
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceVariant"
                android:layout_gravity="center"
                android:id="@+id/textFilterDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="@string/stats_filter_day"/>
        </it.mirko.widget.HapticCard>
        <Space
            android:layout_width="4dp"
            android:layout_height="0dp"/>
        <it.mirko.widget.HapticCard
            android:id="@+id/stats_filter_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/small_corner"
            style="@style/Widget.Material3.CardView.Filled">
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceVariant"
                android:layout_gravity="center"
                android:id="@+id/textFilterMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="@string/stats_filter_month"
                android:alpha="0.3"/>
        </it.mirko.widget.HapticCard>
        <Space
            android:layout_width="4dp"
            android:layout_height="0dp"/>
        <it.mirko.widget.HapticCard
            android:id="@+id/stats_filter_year"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Right"
            style="@style/Widget.Material3.CardView.Filled">
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceVariant"
                android:layout_gravity="center"
                android:id="@+id/textFilterYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="@string/stats_filter_year"
                android:alpha="0.3"/>
        </it.mirko.widget.HapticCard>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
