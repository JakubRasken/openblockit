<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppWidget.AppWidgetContainer.GigaIcon"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.AppWidget.Container">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/heroBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <ImageView
                    android:id="@+id/heroDigits"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/color_on_surface"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"/>
                <ImageView
                    android:id="@+id/heroLock"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/ic_lock"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/presetColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp">
            <FrameLayout
                android:id="@+id/preset1Box"
                android:background="@drawable/app_widget_box_filled"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1">
                <TextView
                    android:gravity="center"
                    android:id="@+id/preset1Text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/google_sans_bold"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/preset2Box"
                android:background="@drawable/app_widget_box_faded"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1">
                <TextView
                    android:gravity="center"
                    android:id="@+id/preset2Text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/google_sans_bold"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/preset3Box"
                android:background="@drawable/app_widget_box_faded"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1">
                <TextView
                    android:gravity="center"
                    android:id="@+id/preset3Text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/google_sans_bold"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/addBox"
                android:background="@drawable/app_widget_box_faded"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/addIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_add"
                    android:scaleType="fitCenter"
                    android:tint="@color/widget_on_surface_variant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/playBox"
                android:background="@drawable/app_widget_box_play"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/widget_preset_title">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/playIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_play"
                    android:scaleType="fitCenter"
                    android:tint="?attr/colorOnPrimary"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
