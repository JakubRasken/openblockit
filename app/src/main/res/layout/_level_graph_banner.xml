<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="end"
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/large_corner"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/colorPrimaryContainer"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Level"
        style="@style/Widget.Material3.CardView.Filled">
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textStyle="bold"
            android:textColor="@color/colorOnPrimaryContainer"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/textLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Ciao lollo"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"/>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
