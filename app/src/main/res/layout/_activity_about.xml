<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutRoot"
    android:background="@color/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <it.mirko.widget.FallingSquaresView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/aboutContent"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:layout_gravity="start|center_vertical"
                android:id="@+id/aboutClose"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@android:string/cancel"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorPrimaryContainer"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_eyebrow"
                android:fontFamily="@font/google_sans_bold"
                android:letterSpacing="0.2"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/fHeader"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="0.12">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fMonoCard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <it.mirko.widget.display.TileDisplay
                    android:id="@+id/fMono"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.card.MaterialCardView>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp">
                <TextView
                    android:textColor="@color/colorOnSurface"
                    android:id="@+id/fName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/francesco"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="26sp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_role_francesco"
                    android:maxLines="2"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/fBlocks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="0.235">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <it.mirko.widget.HapticCard
                        android:id="@+id/fX"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Left"
                        style="@style/Widget.Material3.CardView.Filled">
                        <TextView
                            android:text="@string/label_x"
                            style="@style/AboutBlockLabel"/>
                    </it.mirko.widget.HapticCard>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <it.mirko.widget.HapticCard
                        android:id="@+id/fIg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Right"
                        style="@style/Widget.Material3.CardView.Filled">
                        <TextView
                            android:text="@string/label_instagram"
                            style="@style/AboutBlockLabel"/>
                    </it.mirko.widget.HapticCard>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="6dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <it.mirko.widget.HapticCard
                        android:id="@+id/fYt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Left"
                        style="@style/Widget.Material3.CardView.Filled">
                        <TextView
                            android:text="@string/label_youtube"
                            style="@style/AboutBlockLabel"/>
                    </it.mirko.widget.HapticCard>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <it.mirko.widget.HapticCard
                        android:id="@+id/fWeb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Right"
                        style="@style/Widget.Material3.CardView.Filled">
                        <TextView
                            android:text="@string/about_website"
                            style="@style/AboutBlockLabel"/>
                    </it.mirko.widget.HapticCard>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <it.mirko.widget.HapticCard
                android:id="@+id/fPlay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                app:cardBackgroundColor="@color/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/large_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/fPlayIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/google_play"
                    android:importantForAccessibility="no"
                    app:tint="@color/colorOnPrimaryContainer"/>
            </it.mirko.widget.HapticCard>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/aboutDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
            <View style="@style/AboutDividerTile"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/mHeader"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.1">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mMonoCard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <it.mirko.widget.display.TileDisplay
                    android:id="@+id/mMono"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.card.MaterialCardView>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp">
                <TextView
                    android:textColor="@color/colorOnSurface"
                    android:id="@+id/mName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mirko"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeMaxTextSize="26sp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_role_mirko"
                    android:maxLines="2"
                    android:fontFamily="@font/google_sans_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/mBlocks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="0.235">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <it.mirko.widget.HapticCard
                        android:id="@+id/mIg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Left"
                        style="@style/Widget.Material3.CardView.Filled">
                        <TextView
                            android:text="@string/label_instagram"
                            style="@style/AboutBlockLabel"/>
                    </it.mirko.widget.HapticCard>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <it.mirko.widget.HapticCard
                        android:id="@+id/mX"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Right"
                        style="@style/Widget.Material3.CardView.Filled">
                        <TextView
                            android:text="@string/label_x"
                            style="@style/AboutBlockLabel"/>
                    </it.mirko.widget.HapticCard>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="6dp"/>
                <it.mirko.widget.HapticCard
                    android:id="@+id/mGithub"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceSlider.Down"
                    style="@style/Widget.Material3.CardView.Filled">
                    <TextView
                        android:text="@string/label_github"
                        style="@style/AboutBlockLabel"/>
                </it.mirko.widget.HapticCard>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"/>
            <it.mirko.widget.HapticCard
                android:id="@+id/mPlay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                app:cardBackgroundColor="@color/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/large_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/mPlayIcon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/google_play"
                    android:importantForAccessibility="no"
                    app:tint="@color/colorOnPrimaryContainer"/>
            </it.mirko.widget.HapticCard>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:gravity="center"
            android:id="@+id/aboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/google_sans_regular"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
