<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="fill_vertical"
        android:id="@+id/overlayPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#fff"
        app:cardCornerRadius="48dp"
        style="@style/Widget.Material3.CardView.Filled">
        <Space
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/overlayInner"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">
            <it.mirko.views.BlockLogoSplashMini
                android:id="@+id/overlayMiniLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="12dp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <it.mirko.widget.numbers.SquareNumber
                        android:id="@+id/hourLeftOverlay"
                        android:layout_width="7dp"
                        android:layout_height="11dp"/>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <it.mirko.widget.numbers.SquareNumber
                        android:id="@+id/hourRightOverlay"
                        android:layout_width="7dp"
                        android:layout_height="11dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8">
                    <it.mirko.widget.numbers.SquareNumber
                        android:id="@+id/minuteLeftOverlay"
                        android:layout_width="7dp"
                        android:layout_height="11dp"/>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <it.mirko.widget.numbers.SquareNumber
                        android:id="@+id/minuteRightOverlay"
                        android:layout_width="7dp"
                        android:layout_height="11dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6">
                    <it.mirko.widget.numbers.SquareNumber
                        android:id="@+id/secondLeftOverlay"
                        android:layout_width="7dp"
                        android:layout_height="11dp"/>
                    <Space
                        android:layout_width="6dp"
                        android:layout_height="0dp"/>
                    <it.mirko.widget.numbers.SquareNumber
                        android:id="@+id/secondRightOverlay"
                        android:layout_width="7dp"
                        android:layout_height="11dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
