<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/sheetRoot"
    android:background="@drawable/sheet_bg"
    android:paddingBottom="24dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <it.mirko.views.SliderHandle
        android:id="@+id/sheetHandle"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"/>
    <FrameLayout
        android:id="@+id/sheetIconContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp">
        <ImageView
            android:id="@+id/sheetIcon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/bellBody"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell_body"
            android:importantForAccessibility="no"/>
        <ImageView
            android:id="@+id/bellClapper"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bell_clapper"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/colorOnSurface"
        android:gravity="center"
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_permissions"
        android:fontFamily="@font/google_sans_bold"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/colorOnSurfaceVariant"
        android:gravity="center"
        android:id="@+id/sheetDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:lineSpacingExtra="2dp"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textColor="@color/colorSurface"
        android:id="@+id/sheetGrant"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/onb_grant"
        android:textAllCaps="false"
        app:backgroundTint="@color/colorOnSurface"
        app:cornerRadius="18dp"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textColor="@color/colorSurface"
        android:id="@+id/sheetMiui"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/miui_autostart_button"
        android:textAllCaps="false"
        app:backgroundTint="@color/colorOnSurface"
        app:cornerRadius="18dp"/>
    <it.mirko.widget.ConsentCheck
        android:id="@+id/sheetMiuiConsent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/miui_consent_label"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textColor="@color/colorSurface"
        android:id="@+id/sheetOverlay"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/overlay_button_v2"
        android:textAllCaps="false"
        app:backgroundTint="@color/colorOnSurface"
        app:cornerRadius="18dp"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:id="@+id/sheetDecline"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/routine_sheet_cancel"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"/>
</LinearLayout>
