<?xml version="1.0" encoding="utf-8"?>
<it.mirko.widget.SwipeSections xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        app:liftOnScroll="false">
        <com.google.android.material.appbar.MaterialToolbar
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp">
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="start|center_vertical"
                            android:visibility="gone"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_back"
                            app:tint="?attr/colorOnSurface"/>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/streakBadge"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:elevation="0dp"
                            app:cardBackgroundColor="@color/colorSurfaceBright"
                            app:cardCornerRadius="40dp"
                            app:rippleColor="#44f55314"
                            style="@style/Widget.Material3.CardView.Filled">
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/streakBadgeContent"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp">
                                <View
                                    android:id="@+id/streakTile"
                                    android:background="@drawable/square_dot"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"/>
                                <Space
                                    android:layout_width="6dp"
                                    android:layout_height="0dp"/>
                                <TextView
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface"
                                    android:id="@+id/streakCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/toolbarChutePill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:elevation="0dp"
                        app:cardBackgroundColor="@color/colorSurfaceBright"
                        app:cardCornerRadius="20dp"
                        app:rippleColor="#22f55314"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingStart="12dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:elevation="0dp"
                                app:cardBackgroundColor="?attr/colorOnSurface"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:src="@drawable/ic_parachute"
                                    android:rotation="-25"
                                    app:tint="?attr/colorSurface"/>
                            </com.google.android.material.card.MaterialCardView>
                            <Space
                                android:layout_width="6dp"
                                android:layout_height="0dp"/>
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                android:id="@+id/toolbarChuteCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <Space
                                android:layout_width="6dp"
                                android:layout_height="0dp"/>
                            <View
                                android:background="@color/colorOnSurfaceVariant"
                                android:layout_width="1dp"
                                android:layout_height="18dp"
                                android:alpha="0.35"/>
                            <Space
                                android:layout_width="3dp"
                                android:layout_height="0dp"/>
                            <FrameLayout
                                android:id="@+id/profileButton"
                                android:background="?attr/actionBarItemBackground"
                                android:layout_width="40dp"
                                android:layout_height="40dp">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_gravity="center"
                                    android:id="@+id/profileContainerSmall"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:elevation="0dp"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:cardCornerRadius="20dp"
                                    app:rippleColor="#44f55314"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_account"
                                        app:tint="?attr/colorOnSurface"/>
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/profileImage"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"/>
                                </com.google.android.material.card.MaterialCardView>
                            </FrameLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <it.mirko.views.BlockLogo
                    android:layout_gravity="center"
                    android:id="@+id/homeLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/homeFrame"
        android:paddingTop="100dp"
        android:paddingBottom="128dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/_include_session2"/>
        <include layout="@layout/_include_stats"/>
        <include layout="@layout/_include_control"/>
        <include layout="@layout/_include_bag"/>
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_gravity="bottom"
        android:id="@+id/bottomNavigationView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemTextAppearanceActive="@style/bottomNavigationTextSelected"
        app:itemTextAppearanceInactive="@style/bottomNavigationTextUnselected"
        app:menu="@menu/navigation_menu"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/altNavBarContainer"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="6dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottomNavigationHeight">
            <it.mirko.widget.navigation.AltNavigationBar
                android:layout_gravity="center"
                android:id="@+id/altNavigation"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                app:cardBackgroundColor="@color/colorSurfaceBright"
                app:cardCornerRadius="32dp"
                style="@style/Widget.Material3.CardView.Filled"/>
            <FrameLayout
                android:layout_width="@dimen/alt_fab_container"
                android:layout_height="@dimen/alt_fab_container">
                <it.mirko.widget.HapticFAB
                    android:layout_gravity="center"
                    android:id="@+id/fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_play"
                    android:transitionName="it.mirko.block.TRANSITION_FAB"
                    android:stateListAnimator="@animator/preset_animator"
                    app:backgroundTint="?attr/colorPrimary"
                    app:elevation="0dp"
                    app:tint="?attr/colorOnPrimary"/>
            </FrameLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:elevation="6dp"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="bottom"
        android:id="@+id/confirmContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardElevation="8dp"
        app:rippleColor="@android:color/transparent"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp">
            <FrameLayout
                android:id="@+id/adContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp">
                <FrameLayout
                    android:layout_gravity="top"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/confirmIconP"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardBackgroundColor="@color/colorOnPrimary"
                        app:cardCornerRadius="@dimen/large_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_parachute"
                            android:rotation="-25"
                            app:tint="@color/colorPrimary"/>
                    </com.google.android.material.card.MaterialCardView>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/confirmIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_navigation_session"
                        app:tint="?attr/colorOnPrimary"/>
                </FrameLayout>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/colorOnPrimary"
                        android:id="@+id/confirmText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/session_starting"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/countDown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:progress="50"
                app:indicatorColor="?attr/colorOnPrimary"
                app:trackColor="@color/color_on_primary_alpha"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp"/>
            <it.mirko.widget.HapticButton
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_gravity="end"
                android:id="@+id/buyParachute"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/buy_parachutes"
                android:backgroundTint="@color/colorOnPrimary"
                app:rippleColor="@color/color_on_primary_alpha"
                style="@style/Widget.Material3.Button"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <it.mirko.widget.HapticButton
                    android:textStyle="bold"
                    android:textColor="@color/colorOnPrimary"
                    android:layout_gravity="end"
                    android:id="@+id/continueWithNoParachute"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_with_no_parachutes"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:rippleColor="@color/color_on_primary_alpha"
                    app:strokeColor="@color/colorOnPrimary"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
                <it.mirko.widget.HapticButton
                    android:textStyle="bold"
                    android:textColor="@color/colorOnPrimary"
                    android:layout_gravity="end"
                    android:id="@+id/cancelCountdown"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@android:string/cancel"
                    android:layout_weight="1"
                    app:rippleColor="@color/color_on_primary_alpha"
                    app:strokeColor="@color/colorOnPrimary"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="bottom"
        android:id="@+id/valigiaInfo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#ffe8e3df"
        app:cardCornerRadius="@dimen/large_corner"
        app:cardElevation="0dp"
        app:rippleColor="@android:color/transparent"
        app:strokeWidth="0dp"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/valigiaInfoBox"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:textSize="15sp"
                android:textColor="#ff1e1c1a"
                android:id="@+id/valigiaInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/valigia_empty_hint"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/google_sans_regular"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="bottom"
        android:id="@+id/sliderWarning"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="128dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/large_corner"
        app:cardElevation="8dp"
        app:rippleColor="@android:color/transparent"
        style="@style/Widget.Material3.CardView.Filled">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:id="@+id/sliderWarningTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/no_parachute_title"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/sliderWarningChuteBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/sliderWarningChute"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_parachute"
                        app:tint="@color/colorOnSurface"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:id="@+id/sliderWarningChuteZero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_marginStart="6dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/colorOnSurfaceVariant"
                android:id="@+id/sliderWarningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/parachute_count_text_zero"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sliderWarningBuy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/buy_parachutes"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.Material3.Button.TonalButton"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sliderWarningContinue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_with_no_parachutes"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/blockValigia"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="6dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottomNavigationHeight">
            <FrameLayout
                android:id="@+id/valigiaGlyphContainer"
                android:visibility="gone"
                android:layout_width="@dimen/alt_fab_container"
                android:layout_height="@dimen/alt_fab_container">
                <com.google.android.material.card.MaterialCardView
                    android:layout_gravity="center"
                    android:id="@+id/valigiaGlyph"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:elevation="0dp"
                    app:cardBackgroundColor="@color/colorSurfaceBright"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/valigiaGlyphIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_glyph"
                        app:tint="@color/colorOnSurface"/>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="center"
                android:id="@+id/valigiaPill"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:elevation="0dp"
                app:cardBackgroundColor="@color/blockBarSurface"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/valigiaBagIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_navigation_bag"
                    android:alpha="0"
                    app:tint="@color/colorSurfaceBright"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/valigiaCells"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/valigiaCell0"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/small_corner"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:id="@+id/valigiaIcon0"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/valigiaCell1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/small_corner"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:id="@+id/valigiaIcon1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/valigiaCell2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/small_corner"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="center"
                            android:id="@+id/valigiaIcon2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/valigiaCell3"
                        android:visibility="gone"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:elevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/small_corner"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
