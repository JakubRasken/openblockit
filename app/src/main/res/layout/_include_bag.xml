<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/bagFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/bagGlassFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bagGlass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="@dimen/glass_margin_bottom"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurfaceBright"
                    app:cardCornerRadius="@dimen/large_corner"
                    style="@style/Widget.Material3.CardView.Filled">
                    <it.mirko.widget.BagTiles
                        android:layout_gravity="center"
                        android:id="@+id/bagGlassTiles"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"/>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
            <it.mirko.widget.SquareContainer
                android:orientation="horizontal"
                android:id="@+id/controlSquare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/glass_content_gap"
                app:squareRatio="0.95">
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/controlBagBox"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:cardCornerRadius="@dimen/large_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:orientation="horizontal"
                                android:id="@+id/bagTagRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp">
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagTag0"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:cardCornerRadius="@dimen/small_corner"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <TextView
                                        android:textSize="13sp"
                                        android:textColor="@color/colorOnSurfaceVariant"
                                        android:gravity="center"
                                        android:id="@+id/bagTagLabel0"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"/>
                                </it.mirko.widget.HapticCard>
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagTag1"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:cardCornerRadius="@dimen/small_corner"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <TextView
                                        android:textSize="13sp"
                                        android:textColor="@color/colorOnSurfaceVariant"
                                        android:gravity="center"
                                        android:id="@+id/bagTagLabel1"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"/>
                                </it.mirko.widget.HapticCard>
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagTag2"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:cardCornerRadius="@dimen/small_corner"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <TextView
                                        android:textSize="13sp"
                                        android:textColor="@color/colorOnSurfaceVariant"
                                        android:gravity="center"
                                        android:id="@+id/bagTagLabel2"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"/>
                                </it.mirko.widget.HapticCard>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:orientation="horizontal"
                                android:id="@+id/bagSlotsRow"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1">
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagSlot0"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Left"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/bagIcon0"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_add"
                                        app:tint="@color/colorOnSurfaceVariant"/>
                                </it.mirko.widget.HapticCard>
                                <Space
                                    android:layout_width="6dp"
                                    android:layout_height="0dp"/>
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagSlot1"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Center.Left"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/bagIcon1"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_add"
                                        app:tint="@color/colorOnSurfaceVariant"/>
                                </it.mirko.widget.HapticCard>
                                <Space
                                    android:layout_width="6dp"
                                    android:layout_height="0dp"/>
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagSlot2"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Right"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/bagIcon2"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_add"
                                        app:tint="@color/colorOnSurfaceVariant"/>
                                </it.mirko.widget.HapticCard>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:orientation="horizontal"
                                android:id="@+id/bagSlotsRow2"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="6dp"
                                android:layout_weight="1">
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagSlot3"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Left"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/bagIcon3"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_add"
                                        app:tint="@color/colorOnSurfaceVariant"/>
                                </it.mirko.widget.HapticCard>
                                <Space
                                    android:layout_width="6dp"
                                    android:layout_height="0dp"/>
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagSlot4"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Center.Left"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/bagIcon4"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_add"
                                        app:tint="@color/colorOnSurfaceVariant"/>
                                </it.mirko.widget.HapticCard>
                                <Space
                                    android:layout_width="6dp"
                                    android:layout_height="0dp"/>
                                <it.mirko.widget.HapticCard
                                    android:id="@+id/bagSlot5"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/colorSurface"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Right"
                                    style="@style/Widget.Material3.CardView.Filled">
                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_gravity="center"
                                        android:id="@+id/bagIcon5"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/ic_add"
                                        app:tint="@color/colorOnSurfaceVariant"/>
                                </it.mirko.widget.HapticCard>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="0dp"/>
            </it.mirko.widget.SquareContainer>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/controlSupplyRow"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/controlChuteInfo"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/large_corner"
                    style="@style/Widget.Material3.CardView.Outlined">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:cardBackgroundColor="?attr/colorOnSurface"
                            app:cardCornerRadius="21dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_parachute"
                                android:rotation="-25"
                                app:tint="?attr/colorSurface"/>
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:id="@+id/controlChuteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_gravity="end|top"
                        android:id="@+id/controlChuteBadge"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_margin="12dp"
                        android:scaleX="0"
                        android:scaleY="0"
                        app:cardBackgroundColor="@color/colorPrimaryContainer"
                        app:cardCornerRadius="0dp"
                        style="@style/Widget.Material3.CardView.Filled"/>
                </com.google.android.material.card.MaterialCardView>
                <Space
                    android:layout_width="6dp"
                    android:layout_height="0dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3">
                    <it.mirko.widget.HapticBuyTile
                        android:id="@+id/controlBuyX1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Up.Left"
                        style="@style/Widget.Material3.CardView.Filled"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="6dp"/>
                    <it.mirko.widget.HapticBuyTile
                        android:id="@+id/controlBuyX3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Bottom.Left"
                        style="@style/Widget.Material3.CardView.Filled"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="6dp"
                    android:layout_height="0dp"/>
                <it.mirko.widget.HapticBuyTile
                    android:id="@+id/controlBuyX10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner.Right"
                    style="@style/Widget.Material3.CardView.Filled"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</merge>
