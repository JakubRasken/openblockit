<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:background="@color/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/settingsContent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <FrameLayout
            android:id="@+id/settingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:layout_gravity="start|center_vertical"
                android:id="@+id/settingsClose"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@android:string/cancel"
                app:tint="@color/colorOnSurface"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorPrimaryContainer"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_eyebrow"
                android:fontFamily="@font/google_sans_bold"
                android:letterSpacing="0.2"/>
        </FrameLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/themeBox"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/small_corner"
            style="@style/Widget.Material3.CardView.Filled">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="12dp">
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme"
                    android:layout_marginStart="0dp"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/colorOnSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_theme_desc"
                    android:layout_marginStart="0dp"
                    android:breakStrategy="balanced"/>
                <it.mirko.widget.ThemeSelector
                    android:id="@+id/themeLever"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:minHeight="76dp"
                    android:layout_weight="1"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <it.mirko.widget.HapticCard
            android:id="@+id/hapticFeedbackCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/small_corner"
            style="@style/Widget.Material3.CardView.Filled">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/haptic_feedback_title"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/haptic_feedback_desc"
                        android:breakStrategy="balanced"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <it.mirko.widget.SledSwitch
                    android:id="@+id/hapticSled"
                    android:layout_width="46dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </it.mirko.widget.HapticCard>
        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"/>
        <it.mirko.widget.HapticCard
            android:id="@+id/streakReminderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/small_corner"
            style="@style/Widget.Material3.CardView.Filled">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/streak_reminder_setting_title"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/streak_reminder_setting_desc"
                        android:breakStrategy="balanced"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <it.mirko.widget.SledSwitch
                    android:id="@+id/streakSled"
                    android:layout_width="46dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </it.mirko.widget.HapticCard>
        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"/>
        <it.mirko.widget.HapticCard
            android:id="@+id/routineBagCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/small_corner"
            style="@style/Widget.Material3.CardView.Filled">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/routine_bag_setting_title"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/routine_bag_setting_desc"
                        android:breakStrategy="balanced"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <it.mirko.widget.SledSwitch
                    android:id="@+id/routineBagSled"
                    android:layout_width="46dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </it.mirko.widget.HapticCard>
        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp"/>
        <it.mirko.widget.HapticCard
            android:id="@+id/silenceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/small_corner"
            style="@style/Widget.Material3.CardView.Filled">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/silence_setting_title"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/silence_setting_desc"
                        android:breakStrategy="balanced"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <it.mirko.widget.SledSwitch
                    android:id="@+id/silenceSled"
                    android:layout_width="46dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </it.mirko.widget.HapticCard>
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/settingsBottomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <it.mirko.widget.HapticCard
                android:id="@+id/removeAdsCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:id="@+id/removeAdsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_go_premium_title"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/colorOnSurface"
                        android:id="@+id/removeAdsDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_go_premium_desc"
                        android:paddingEnd="24dp"
                        android:breakStrategy="balanced"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:alpha="0.5"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/colorOnSurface"/>
            </it.mirko.widget.HapticCard>
            <Space
                android:layout_width="6dp"
                android:layout_height="match_parent"/>
            <it.mirko.widget.HapticCard
                android:id="@+id/settingsInfoCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="12dp">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_info_title"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/colorOnSurface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_info_desc"
                        android:paddingEnd="24dp"
                        android:breakStrategy="balanced"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <ImageView
                    android:layout_gravity="end|bottom"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:alpha="0.5"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/colorOnSurface"/>
            </it.mirko.widget.HapticCard>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
