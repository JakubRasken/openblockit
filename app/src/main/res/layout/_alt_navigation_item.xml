<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="?attr/actionBarItemBackground"
    android:layout_width="48dp"
    android:layout_height="64dp">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="center"
        android:id="@+id/itemSelectedContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="@color/colorSecondaryContainer"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        style="@style/Widget.Material3.CardView.Filled"/>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="40dp"
        android:layout_height="40dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/navIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_navigation_stats"/>
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/maskStats"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:translationX="-24dp"
                app:cardBackgroundColor="@color/colorSecondaryContainer"
                app:cardCornerRadius="0dp"
                style="@style/Widget.Material3.CardView.Filled"/>
        </FrameLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="end"
            android:id="@+id/badge"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/colorPrimaryContainer"
            app:cardCornerRadius="0dp"
            style="@style/Widget.Material3.CardView.Filled"/>
    </FrameLayout>
</FrameLayout>
