<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/premiumRoot"
    android:background="@color/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <it.mirko.widget.FallingSquaresView
        android:id="@+id/premiumFalling"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/premiumContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <androidx.appcompat.widget.AppCompatImageButton
                android:layout_gravity="start|center_vertical"
                android:id="@+id/premiumClose"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@android:string/cancel"
                app:tint="@color/colorOnSurface"/>
            <it.mirko.views.BlockLogoStatic
                android:layout_gravity="center"
                android:id="@+id/premiumLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/premiumTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <it.mirko.widget.HapticCard
                android:id="@+id/premiumTabOne"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="22dp"
                style="@style/Widget.Material3.CardView.Filled">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:id="@+id/premiumTabOneLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/premium_tab_premium"
                    android:fontFamily="@font/google_sans_bold"/>
            </it.mirko.widget.HapticCard>
            <it.mirko.widget.HapticCard
                android:id="@+id/premiumTabTwo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="22dp"
                style="@style/Widget.Material3.CardView.Filled">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:id="@+id/premiumTabTwoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/premium_tab_addon"
                    android:fontFamily="@font/google_sans_bold"/>
            </it.mirko.widget.HapticCard>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <it.mirko.widget.SwipePager
            android:id="@+id/premiumPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorPrimaryContainer"
            android:layout_gravity="center_horizontal"
            android:id="@+id/premiumRestore"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/premium_restore"
            android:textAllCaps="true"
            android:fontFamily="@font/google_sans_bold"
            android:letterSpacing="0.06"/>
    </LinearLayout>
</FrameLayout>
