<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <it.mirko.widget.FallingSquaresView
        android:id="@+id/squaresBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/cascadeLayer"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/ticketViewport"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/ticketFrame"
            android:layout_width="256dp"
            android:layout_height="404dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ticketPieces"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/focalArea"
                    android:paddingTop="18dp"
                    android:clipChildren="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="70"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <LinearLayout
                        android:layout_gravity="start|top"
                        android:orientation="vertical"
                        android:id="@+id/passengerBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onb_passenger"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.12"/>
                        <com.robinhood.ticker.TickerView
                            android:id="@+id/passengerTicker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            app:ticker_animateMeasurementChange="true"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/colorPrimaryContainer"
                        android:layout_gravity="end|top"
                        android:id="@+id/counterLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01 / 04"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/permGroup"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:clipChildren="false"
                            android:layout_width="66dp"
                            android:layout_height="66dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/permIcon"
                                android:padding="15dp"
                                android:layout_width="96dp"
                                android:layout_height="96dp"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/permBellBody"
                                android:padding="15dp"
                                android:visibility="gone"
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:src="@drawable/ic_bell_body"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/permBellClapper"
                                android:padding="15dp"
                                android:visibility="gone"
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:src="@drawable/ic_bell_clapper"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:id="@+id/permName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.16"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="bottom|center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/completedRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:alpha="0"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_gravity="start|top"
                        android:id="@+id/ticketLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onb_ticket_label"
                        android:alpha="0.4"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/stub"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="30">
                    <it.mirko.views.BlockLogoStatic
                        android:layout_gravity="center"
                        android:id="@+id/stubLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/parachuteReveal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0">
                        <TextView
                            android:textSize="9sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:id="@+id/couponLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/onb_emergency"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.22"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/parachuteImg"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_parachute_big"/>
                            <it.mirko.views.TileNumberView
                                android:id="@+id/countTiles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp">
                        <View
                            android:layout_gravity="center"
                            android:id="@+id/dragGrip"
                            android:background="@drawable/onb_grip"
                            android:layout_width="46dp"
                            android:layout_height="5dp"/>
                        <LinearLayout
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/progressDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0"/>
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
            <it.mirko.views.TearDashesView
                android:id="@+id/tearDashes"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:id="@+id/topFade"
        android:background="@drawable/top_fade_scrim"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topPanel"
        android:paddingTop="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/colorPrimaryContainer"
            android:id="@+id/tearEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/onb_eyebrow_done"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textStyle="bold"
            android:id="@+id/tearTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onb_ready_title"
            android:letterSpacing="-0.02"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:id="@+id/tearDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onb_tear_reminder_full"
            android:lineSpacingExtra="3dp"
            android:alpha="0.7"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/mid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.62"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomPanel"
        android:paddingBottom="28dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/colorPrimaryContainer"
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/onb_eyebrow_boarding"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textStyle="bold"
            android:ellipsize="end"
            android:id="@+id/permissionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onb_welcome_title"
            android:maxLines="1"
            android:letterSpacing="-0.02"
            app:autoSizeMaxTextSize="28sp"
            app:autoSizeMinTextSize="17sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:gravity="top"
            android:id="@+id/permissionDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/onb_welcome_desc"
            android:maxLines="3"
            android:minLines="3"
            android:lineSpacingExtra="3dp"
            android:alpha="0.7"/>
        <it.mirko.widget.HapticButton
            android:textStyle="bold"
            android:id="@+id/concedi"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onb_grant"
            style="@style/Widget.Material3.Button"/>
        <it.mirko.widget.HapticButton
            android:textStyle="bold"
            android:id="@+id/onbMiuiBtn"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/miui_autostart_button"
            style="@style/Widget.Material3.Button"/>
        <it.mirko.widget.ConsentCheck
            android:id="@+id/onbMiuiConsent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/miui_consent_label"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skipBtn"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/onb_continue_guest"
            style="@style/Widget.Material3.Button.TextButton"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:id="@+id/privacyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/privacy_policy"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@style/Widget.Material3.Button.TextButton"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:alpha="0.6"/>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:id="@+id/termsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/terms_and_conditions"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@style/Widget.Material3.Button.TextButton"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/colorPrimaryContainer"
        android:gravity="center_vertical"
        android:id="@+id/tearReminder"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="46dp"
        android:text="@string/onboarding_tear_reminder"
        android:drawablePadding="8dp"
        android:alpha="0"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <it.mirko.views.BlockLogoSplash
        android:id="@+id/introMark"
        android:visibility="invisible"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
