<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/controlFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/controlGlassFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/controlGlass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="@dimen/glass_margin_bottom"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/colorSurfaceBright"
                    app:cardCornerRadius="@dimen/large_corner"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="horizontal"
                            android:id="@+id/controlDigitsRow"
                            android:layout_width="match_parent"
                            android:layout_height="60dp">
                            <it.mirko.widget.display.TileDisplay
                                android:id="@+id/controlStartDigits"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="24dp"/>
                            <it.mirko.widget.display.TileDisplay
                                android:id="@+id/controlEndDigits"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <it.mirko.widget.TimelineBar
                            android:id="@+id/controlTimeline"
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginTop="12dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/routineTabRow"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="@dimen/glass_content_gap"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <it.mirko.widget.HapticCard
                    android:id="@+id/routineTab0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:id="@+id/routineTabLabel0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/colorOnSurface"
                            android:gravity="center"
                            android:id="@+id/routineTabTime0"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/google_sans_bold"/>
                        <it.mirko.widget.PowerTiles
                            android:id="@+id/routinePower0"
                            android:layout_width="match_parent"
                            android:layout_height="22dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </it.mirko.widget.HapticCard>
                <it.mirko.widget.HapticCard
                    android:id="@+id/routineTab1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:id="@+id/routineTabLabel1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/colorOnSurface"
                            android:gravity="center"
                            android:id="@+id/routineTabTime1"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/google_sans_bold"/>
                        <it.mirko.widget.PowerTiles
                            android:id="@+id/routinePower1"
                            android:layout_width="match_parent"
                            android:layout_height="22dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </it.mirko.widget.HapticCard>
                <it.mirko.widget.HapticCard
                    android:id="@+id/routineTab2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:id="@+id/routineTabLabel2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/colorOnSurface"
                            android:gravity="center"
                            android:id="@+id/routineTabTime2"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/google_sans_bold"/>
                        <it.mirko.widget.PowerTiles
                            android:id="@+id/routinePower2"
                            android:layout_width="match_parent"
                            android:layout_height="22dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </it.mirko.widget.HapticCard>
                <it.mirko.widget.SledSwitch
                    android:id="@+id/routineSled"
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/small_corner"
                    style="@style/Widget.Material3.CardView.Filled"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/controlWeekBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@color/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/large_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <it.mirko.widget.DayFaders
                        android:id="@+id/controlWeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/routineFacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/colorOnSurface"
                            android:id="@+id/routineNextStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:fontFamily="@font/google_sans_bold"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/routine_facts_separator"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/colorPrimaryContainer"
                            android:id="@+id/routineDurationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:fontFamily="@font/google_sans_bold"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <TextView
                        android:id="@+id/routineDurationDesc"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="76dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardBackgroundColor="@color/colorSurface"
                            app:cardCornerRadius="@dimen/small_corner"
                            style="@style/Widget.Material3.CardView.Outlined">
                            <it.mirko.widget.RombiKnob
                                android:id="@+id/controlStartKnob"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="76dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardBackgroundColor="@color/colorSurface"
                            app:cardCornerRadius="@dimen/small_corner"
                            style="@style/Widget.Material3.CardView.Outlined">
                            <it.mirko.widget.RombiKnob
                                android:id="@+id/controlEndKnob"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/routine_start_label"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:letterSpacing="0.14"/>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/routine_end_label"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:letterSpacing="0.14"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</merge>
