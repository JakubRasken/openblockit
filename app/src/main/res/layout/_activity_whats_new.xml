<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wnRoot"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <it.mirko.widget.FallingSquaresView
        android:id="@+id/wnSquaresBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <it.mirko.widget.SwipePager
        android:id="@+id/wnPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_gravity="end|top"
        android:id="@+id/wnSkip"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wn_skip"
        android:letterSpacing="0.02"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/wnBottomBar"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/wnDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/wnLater"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wn_overlay_later"
            android:textAllCaps="false"
            style="@style/Widget.Material3.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton
            android:textStyle="bold"
            android:textColor="?attr/colorSurface"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/wnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wn_next"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:backgroundTint="?attr/colorOnSurface"
            app:cornerRadius="18dp"
            style="@style/Widget.Material3.Button"/>
    </FrameLayout>
</FrameLayout>
