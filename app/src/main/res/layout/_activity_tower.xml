<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/towerScroll"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/towerColumn"
            android:paddingTop="120dp"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/towerEmptyDot"
                android:background="@color/colorPrimaryContainer"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="20dp"/>
            <it.mirko.widget.display.TileDisplay
                android:id="@+id/towerTotal"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:id="@+id/towerDaysLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tower_days_label"
                android:letterSpacing="0.2"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="28dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/towerFloors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/towerStatsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/footBestBox"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceBright"
                        app:cardCornerRadius="@dimen/large_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorOnSurface"
                                android:id="@+id/footSessions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="9sp"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/tower_foot_best"
                                android:letterSpacing="0.14"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceBright"
                        app:cardCornerRadius="@dimen/large_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorOnSurface"
                                android:id="@+id/footMinutes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="9sp"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/tower_foot_minutes"
                                android:letterSpacing="0.14"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="10dp"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceBright"
                        app:cardCornerRadius="@dimen/large_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorOnSurface"
                                android:id="@+id/footAvg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="9sp"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/tower_foot_avg"
                                android:letterSpacing="0.14"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/colorSurfaceBright"
                        app:cardCornerRadius="@dimen/large_corner"
                        style="@style/Widget.Material3.CardView.Filled">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <TextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimaryContainer"
                                android:id="@+id/footRecord"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:textSize="9sp"
                                android:textColor="@color/colorOnSurfaceVariant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/tower_foot_record"
                                android:letterSpacing="0.14"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
    <FrameLayout
        android:id="@+id/towerRain"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <View
        android:layout_gravity="end"
        android:id="@+id/towerScrub"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="12dp"/>
    <View
        android:layout_gravity="start"
        android:id="@+id/towerScrubLeft"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="12dp"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="end"
        android:id="@+id/towerScrubBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:layout_marginEnd="56dp"
        android:elevation="6dp"
        app:cardBackgroundColor="@color/colorOnSurface"
        app:cardCornerRadius="@dimen/small_corner"
        style="@style/Widget.Material3.CardView.Filled">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorSurface"
            android:id="@+id/towerScrubLevel"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:id="@+id/towerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="center_vertical"
                android:id="@+id/towerRecordPill"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:elevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceBright"
                app:cardCornerRadius="40dp"
                style="@style/Widget.Material3.CardView.Filled">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/towerBarContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="6dp"
                    android:paddingEnd="10dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/towerBack"
                        android:background="?attr/actionBarItemBackground"
                        android:padding="10dp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_back"
                        app:tint="@color/colorOnSurface"/>
                    <it.mirko.widget.display.TileDisplay
                        android:id="@+id/towerBarNumber"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_weight="1"
                        android:alpha="0"/>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/towerReserve"
                        android:background="@drawable/reserve_box_bg"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginEnd="12dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </com.google.android.material.card.MaterialCardView>
            <Space
                android:layout_width="10dp"
                android:layout_height="0dp"/>
            <it.mirko.widget.HapticCard
                android:id="@+id/towerHelp"
                android:layout_width="46dp"
                android:layout_height="68dp"
                android:elevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceBright"
                app:cardCornerRadius="@dimen/small_corner"
                style="@style/Widget.Material3.CardView.Filled">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?"/>
            </it.mirko.widget.HapticCard>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</FrameLayout>
