<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:interpolator="@android:interpolator/decelerate_cubic"
        android:duration="190"
        android:valueFrom="0"
        android:valueTo="-70"
        android:propertyName="translateX"/>
    <objectAnimator
        android:interpolator="@android:interpolator/overshoot"
        android:duration="380"
        android:startOffset="190"
        android:valueFrom="-70"
        android:valueTo="0"
        android:propertyName="translateX"/>
</set>
